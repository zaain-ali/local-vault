# Copy to apps/server/.env and fill in your own values.
# None of these accounts ship with the repo. Never commit .env.

# development | production
ENV=development
PORT=8080

# Required for the API. Community Edition locally, Docker, or Atlas.
# Using MongoDB does not change this project's MIT license.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=localvault

# Required in production (min 32 bytes, not the dev default).
# In development the server falls back to an insecure placeholder if unset.
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h

# Required for lv login and the dashboard when you run your own server.
# GitHub → Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/github/callback

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional. Without RabbitMQ the API still starts; invite emails and
# cross-instance events are disabled. CLOUDAMQP_URL is also accepted.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Optional. Invite emails (lv invite) go through Resend.
# Leave empty for local work that does not send mail.
# Bring your own key — Resend free tier (verified domain) is enough for most self-hosters.
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
EMAIL_MAX_RETRIES=5
EMAIL_RETRY_DELAY=30s

# Clients must sign x-lv-server-id with this value (AWS workload identity).
LV_AWS_SERVER_ID=localvault
